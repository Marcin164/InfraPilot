# Managed by Ansible (ops/ansible/templates/env.j2) — do not edit by hand on
# the server, edit group_vars and re-run: ansible-playbook playbook.yml --tags env
# Mirrors the root .env.example; see that file for what each var does.

# ==== Required ====

PROPELAUTH_AUTH_URL={{ propelauth_auth_url }}
PROPELAUTH_API_KEY={{ propelauth_api_key }}
VITE_AUTH_URL={{ vite_auth_url | default(propelauth_auth_url) }}

ENCRYPTION_KEY={{ encryption_key }}

DB_USERNAME={{ db_username | default('infrapilot') }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name | default('InfraPilot') }}
DB_SCHEMA={{ db_schema | default('public') }}

CORS_ORIGINS={{ cors_origins | default('https://' + app_domain) }}

ADMIN_EMAIL={{ admin_email | default('') }}

# ==== Security & behavior ====

TRUST_PROXY={{ trust_proxy | default(true) | lower }}
TYPEORM_SYNCHRONIZE={{ typeorm_synchronize | default(true) | lower }}
MFA_REQUIRED={{ mfa_required | default(true) | lower }}

AGENT_PUBLIC_BASE_URL={{ agent_public_base_url | default('https://' + app_domain + '/api') }}

# ==== Active Directory (optional bootstrap) ====

AD_URL={{ ad_url | default('') }}
AD_BASE_DN={{ ad_base_dn | default('') }}
AD_USERNAME={{ ad_username | default('') }}
AD_PASSWORD={{ ad_password | default('') }}

# ==== Optional integrations ====

GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('') }}

AUDIT_SINK_FILE_PATH={{ audit_sink_file_path | default('') }}
AUDIT_SINK_URL={{ audit_sink_url | default('') }}
AUDIT_SINK_TOKEN={{ audit_sink_token | default('') }}
AUDIT_SINK_FORMAT={{ audit_sink_format | default('generic') }}
AUDIT_SINK_QUEUE_MAX={{ audit_sink_queue_max | default(1000) }}

SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_SECURE={{ smtp_secure | default(false) | lower }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASS={{ smtp_pass | default('') }}
MAIL_FROM_ADDRESS={{ mail_from_address | default('infrapilot@localhost') }}

REMOTE_ASSIST_BASE_URL={{ remote_assist_base_url | default('') }}
REMOTE_ASSIST_TOKEN_SECRET={{ remote_assist_token_secret | default('') }}

AGENT_INSTALLER_URL_WINDOWS={{ agent_installer_url_windows | default('') }}
AGENT_INSTALLER_URL_MACOS={{ agent_installer_url_macos | default('') }}

TICKET_AWAIT_REMIND_HOURS={{ ticket_await_remind_hours | default(48) }}
TICKET_AWAIT_AUTOCLOSE_HOURS={{ ticket_await_autoclose_hours | default(168) }}
