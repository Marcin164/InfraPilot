# Single .env for the whole project — copy to .env and fill in.
# Never commit the real values.
#
# docker-compose.yml reads ONLY this file: Compose auto-loads it for ${VAR}
# substitution inside docker-compose.yml itself (build args, db: service
# config) AND injects it into the api container via env_file:. One file,
# one place to configure a deployment.
#
# Local dev without Docker (npm run start:dev from backend/) reads its own
# .env from backend/ instead — copy this file there and add
# DB_HOST=localhost, PORT=3000, NODE_ENV=development (docker-compose.yml
# hardcodes those three for the containerized deployment, so they're not
# listed below).

# ==== Required ====

# PropelAuth
PROPELAUTH_AUTH_URL=
PROPELAUTH_API_KEY=
# Same tenant URL as PROPELAUTH_AUTH_URL above, baked into the frontend at
# build time — changing it requires `docker compose up -d --build frontend`.
VITE_AUTH_URL=

# AES-256 key for app-level encryption (32 bytes recommended).
# Generate with: openssl rand -hex 32
# Protects the AD bind password, network device SSH creds, SMTP and M365
# secrets. Losing this key permanently locks you out of every encrypted
# secret already stored — keep an offline backup, not just this file.
ENCRYPTION_KEY=

# Database — source of truth for both the db: and api services in
# docker-compose.yml. DB_HOST/DB_PORT aren't here — hardcoded to db/5432
# there, since that's always the internal service name in this topology.
DB_USERNAME=infrapilot
DB_PASSWORD=
DB_NAME=InfraPilot
DB_SCHEMA=public

# Origin you open the app at in the browser — no trailing slash, no port
# (Nginx unifies frontend + API under one origin, see DEPLOYMENT.md
# section 5). Comma-separated if more than one, e.g.
# http://192.168.1.41 or https://your-domain.
CORS_ORIGINS=

# First-run bootstrap: if the users table is empty on startup, this email
# gets an admin account automatically. Must match a PropelAuth account.
# Remove or leave blank after the first deploy.
ADMIN_EMAIL=

# ==== Security & behavior ====

# Only 'true' when this app runs behind a reverse proxy that sets
# X-Forwarded-For — it does here (Nginx, DEPLOYMENT.md section 5). Enables
# trusting that header for rate-limiting/logging. Without a real proxy in
# front, a client could spoof its own IP and bypass rate limits, so only
# enable this together with the Nginx setup.
TRUST_PROXY=true

# 'true' mutates the DB schema on every boot — fine for first deploy on an
# empty database, switch to 'false' + migrations once the schema settles.
TYPEORM_SYNCHRONIZE=true

# Require MFA on sensitive modules (audit export, privacy erase/export,
# legal hold, retention run, AD sync, SMTP, M365, compliance, CVE, fleet).
# Anything other than 'true' (including unset) disables enforcement app-wide.
MFA_REQUIRED=true

# Pins the base URL baked into every Windows/macOS/Linux agent installer
# snippet (Settings > Agent) to your reverse proxy, e.g.
# http://192.168.1.41/api or https://your-domain/api — agents go through
# Nginx too, never directly to :3000. Without this the URL is derived from
# whatever Host header the admin's browser sent, so opening Settings
# through the raw :3000 port by mistake bakes that wrong address in.
AGENT_PUBLIC_BASE_URL=

# ==== Active Directory (optional bootstrap) ====
# Leave blank and configure via Settings > Active Directory in the app
# instead — these only seed the connection on first boot if the database
# has none saved yet.
AD_URL=
AD_BASE_DN=
AD_USERNAME=
AD_PASSWORD=

# ==== Optional integrations ====

# Grafana admin password (grafana: service in docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=

# Audit log external sinks
AUDIT_SINK_FILE_PATH=
AUDIT_SINK_URL=
AUDIT_SINK_TOKEN=
AUDIT_SINK_FORMAT=generic
AUDIT_SINK_QUEUE_MAX=1000

# Outbound mail — configure SMTP_HOST to enable real sending.
# Corporate server example:  SMTP_HOST=mail.firma.pl  SMTP_PORT=587
# Gmail example:             SMTP_HOST=smtp.gmail.com SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
# Without SMTP_HOST the service logs mails only (stub/dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=infrapilot@localhost

# Remote assist
REMOTE_ASSIST_BASE_URL=
REMOTE_ASSIST_TOKEN_SECRET=

# Agent installer downloads. Leave blank to self-host: upload the
# .exe/.pkg from Settings > Windows/macOS Agent and it's served from this
# backend at /devices/agent/installer?platform=windows|macos. Set these
# only to point at an external host (CDN / GitHub Releases) instead.
# AGENT_INSTALLER_URL (no suffix) is a legacy alias for AGENT_INSTALLER_URL_WINDOWS.
AGENT_INSTALLER_URL=
AGENT_INSTALLER_URL_WINDOWS=
AGENT_INSTALLER_URL_MACOS=

# Legacy fleet-wide agent enrollment token (shared secret, matched with
# timingSafeEqual). Superseded by per-device one-time tokens minted from
# Settings > Agent > "Nowy token" — the UI no longer surfaces this for new
# installs. Only needed to keep enrollment snippets generated before
# per-device tokens existed working. Leave blank for new deployments.
AGENT_ENROLLMENT_TOKEN=

# Ticket auto-followup tuning
TICKET_AWAIT_REMIND_HOURS=48
TICKET_AWAIT_AUTOCLOSE_HOURS=168
