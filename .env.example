# Root .env for docker-compose.yml — copy to .env and fill in.
# Never commit the real values. See backend/.env.example for the backend's
# own (larger) set of variables — that's a separate file, ./backend/.env.

# Source of truth for DB credentials — feeds both the db: service and,
# via explicit environment: overrides in docker-compose.yml, the api
# service too. backend/.env has its own copies for local dev / the
# standalone backend/docker-compose.yml, but when running through this
# root compose file, these values win.
DB_USERNAME=infrapilot
DB_PASSWORD=
DB_NAME=InfraPilot

# PropelAuth tenant URL — same value goes into backend/.env as
# PROPELAUTH_AUTH_URL. This is the only frontend build-time var that still
# needs setting per install (it's an external auth provider domain, can't
# be inferred from where the app is running).
VITE_AUTH_URL=

# VITE_API_URL / VITE_WS_URL intentionally NOT here — the frontend infers
# the backend's address from the page's own origin at runtime (Nginx
# proxies /api and /socket.io on that same origin, see DEPLOYMENT.md
# section 5), so one built image works at any customer's IP/domain with no
# rebuild. Only set these as extra docker-compose build args if the API is
# ever served from a different origin than the SPA.
